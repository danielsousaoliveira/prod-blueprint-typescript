{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "persistence/pg/migrations/**/*.sql",
        "watchAssets": false
      },
      {
        "include": "persistence/pg/migrations/**/*.json",
        "watchAssets": false
      }
    ]
  }
}
