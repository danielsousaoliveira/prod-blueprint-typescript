    "@nestjs/graphql": "^13.4.2",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/testing": "^11.1.28",
    "argon2": "^0.45.1",
    "bullmq": "^5.81.2",
    "cookie-parser": "^1.4.7",
    "dataloader": "^2.2.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.14.2",
    "graphql-query-complexity": "^2.0.0",
