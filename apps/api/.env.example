# Copy to .env for local development. Never commit .env itself.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# directConnection=true is required when talking to a single-node replica set from
# outside Docker: without it the driver reads the replica set config, sees the member
# advertised as "localhost:27017" from the container's point of view, and tries to
# reconnect through that instead of the port mapping.
MONGO_URL=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGO_DB_NAME=scheduler

REDIS_URL=redis://localhost:6379

SHUTDOWN_TIMEOUT_MS=8000

NOTIFICATION_PROVIDER_URL=https://notifications.example
NOTIFICATION_API_KEY=dev-key

# --- Authentication -------------------------------------------------------
# Sessions are opaque ids stored in Redis, so there is NO signing secret to manage.
# That is a small argument in favour of sessions over a JWT (DECISIONS §31).

# Idle timeout: the store slides this on every authenticated request, so it is
# "7 days of inactivity" rather than "7 days".
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=sid

# Defaults to true. Set false ONLY for local HTTP — a Secure cookie over plain HTTP is
# silently discarded by the browser, so login returns 200 and every subsequent request
# is 401 with no error explaining why.
SESSION_COOKIE_SECURE=false

# Login brute-force limits. Two counters, because email-only enables lockout attacks and
# IP-only misses password spraying. Per-IP is looser: offices share addresses.
AUTH_MAX_ATTEMPTS_PER_EMAIL=5
AUTH_MAX_ATTEMPTS_PER_IP=30
AUTH_ATTEMPT_WINDOW_SECONDS=900

# Origins allowed to make state-changing requests (CSRF defence in depth).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Password for the demo accounts seeded by migration 005. Refused in production.
SEED_DEMO_PASSWORD=demo-password-123
